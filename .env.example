# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=rental_management
DB_USERNAME=root
DB_PASSWORD=rootpass

# JWT
JWT_SECRET=
JWT_EXPIRATION=28800000

# PayWay Sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_CALLBACK_URL=

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ENABLED=false

# Account security / OTP / 2FA
APP_SECURITY_TWO_FACTOR_REQUIRED_ROLES=

# Optional bootstrap of the initial SUPER_ADMIN account
# DISABLED BY DEFAULT: set SUPER_ADMIN_BOOTSTRAP_ENABLED=true AND all three of
# username/email/password to provision. It is a no-op otherwise, so a normal start
# cannot create an account. Leave blank once the account exists; the account is never
# recreated/duplicated on later starts and an existing user's password is never
# overwritten. The email must be on the internal @rental.com domain. The password is
# hashed (BCrypt) and is never logged.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=

# API rate limiting (optional overrides; defaults are documented in application.properties)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
# Set to true ONLY when running behind a strict reverse proxy (e.g. ngrok/nginx
# that rewrites X-Forwarded-For), otherwise clients can spoof their IP.
# RATE_LIMIT_AUTH_LOGIN_ACCOUNT_CAPACITY=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Assistant (OpenRouter)
AI_ENABLED=true
AI_PROVIDER=openrouter
AI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_READ_TIMEOUT_SECONDS=180
AI_MAX_TOOL_CALLS=6
AI_HISTORY_MESSAGES=12
